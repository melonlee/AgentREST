# Copy to .env (git-ignored) and replace every value. Used by docker-compose.yml.

# >= 32 random bytes:  openssl rand -base64 48
JWT_SECRET=

# MySQL credentials (the app connects as user "lazyrest")
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# First administrator, created only when the database has no users (>= 12 chars)
LAZYREST_ADMIN_USERNAME=admin
LAZYREST_ADMIN_EMAIL=admin@example.com
LAZYREST_ADMIN_PASSWORD=

# Optional
MCP_WRITE_TOOLS_ENABLED=false
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=
